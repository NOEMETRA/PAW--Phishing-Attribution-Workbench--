ARG PYTHON_IMAGE=python:3.12-slim-bookworm
FROM ${PYTHON_IMAGE} AS build

ARG PAW_TEXT_TRIAGE=0
WORKDIR /src
COPY pyproject.toml setup.py MANIFEST.in requirements.txt README.md LICENSE ./
COPY paw/ ./paw/
RUN python -m venv /opt/paw \
    && case "$PAW_TEXT_TRIAGE" in \
        0) /opt/paw/bin/pip install --no-cache-dir . ;; \
        1) /opt/paw/bin/pip install --no-cache-dir '.[text-triage]' ;; \
        *) echo 'PAW_TEXT_TRIAGE must be 0 or 1' >&2; exit 2 ;; \
    esac

FROM ${PYTHON_IMAGE}
RUN apt-get update \
    && apt-get install -y --no-install-recommends libmagic1 \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir /input /data
COPY --from=build /opt/paw /opt/paw

ENV PATH="/opt/paw/bin:$PATH" PAW_DATA_DIR=/data HOME=/tmp PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /data
USER 1000:1000
ENTRYPOINT ["paw"]
CMD ["--help"]
